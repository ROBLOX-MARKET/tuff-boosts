# Copy these into Vercel > Project > Settings > Environment Variables.
# Never upload a real .env file to GitHub.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# NOWPayments > Settings > Payments (API key) and IPN settings (secret)
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret

# Your live address, no slash at the end
NEXT_PUBLIC_SITE_URL=https://tuffboosts.com
