# Copy this file to ".env" (or set these in your host's "Environment Variables" panel).
# NEVER put real values in code or share them. If a token leaks, reset it.

# Your Discord bot token — Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=PASTE_YOUR_FRESH_TOKEN_HERE

# Your ChangeNOW API key — free at https://changenow.io (Account > API)
CHANGENOW_API_KEY=PASTE_YOUR_CHANGENOW_KEY_HERE

# (Optional) Your server ID, so slash commands show up instantly instead of ~1h.
# Right-click your server icon > Copy Server ID (needs Developer Mode on).
GUILD_ID=
